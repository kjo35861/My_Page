# Supabase 프로젝트 설정 (Settings > API 에서 확인)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon key가 아니라 service_role key를 사용합니다 (서버에서만 사용, 절대 프론트에 노출 금지)
SUPABASE_SERVICE_KEY=service_role_key_here

# WebAuthn Relying Party 설정
# RP_ID는 배포 도메인(포트/스킴 제외)과 정확히 같아야 함. 로컬 개발은 localhost.
RP_NAME=My Page
RP_ID=localhost
ORIGIN=http://localhost:3000

PORT=3000
